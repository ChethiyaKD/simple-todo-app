{
  "info": {
    "name": "Todo App API",
    "description": "Postman collection for the Todo App with example values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/todos",
          "host": ["{{base_url}}"],
          "path": ["api", "todos"]
        }
      }
    },
    {
      "name": "Create Todo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Buy groceries\",\n    \"description\": \"Milk, Bread, Cheese, and Eggs\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/todos",
          "host": ["{{base_url}}"],
          "path": ["api", "todos"]
        }
      }
    },
    {
      "name": "Update Todo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Buy groceries\",\n    \"description\": \"Only Milk and Bread needed now\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/todos/{{todo_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "todos", "{{todo_id}}"]
        }
      }
    },
    {
      "name": "Mark Todo as Done",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/todos/{{todo_id}}/done",
          "host": ["{{base_url}}"],
          "path": ["api", "todos", "{{todo_id}}", "done"]
        }
      }
    },
    {
      "name": "Delete Todo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/todos/{{todo_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "todos", "{{todo_id}}"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "todo_id",
      "value": "REPLACE_WITH_ACTUAL_ID",
      "type": "string"
    }
  ]
}
